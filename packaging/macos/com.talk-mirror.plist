<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.talk-mirror</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/talk-mirror</string>
        <string>-d</string>
        <string>/usr/local/var/talk-mirror</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/usr/local/var/talk-mirror/talk-mirror.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/talk-mirror/talk-mirror.log</string>
</dict>
</plist>
